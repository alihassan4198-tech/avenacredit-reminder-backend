APP_ENV=production

# Supabase: use the pooler connection string (Project Settings -> Database -> Connection pooling), with sslmode=require.
# Locally, docker-compose.local.yml uses the "postgres" service instead.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Only used by docker-compose.local.yml
POSTGRES_DB=credit_reminder
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Public URL of the avenacredit-reminder-form app on Vercel (unsubscribe links and email logo point here)
APP_BASE_URL=https://example.com

# Secrets: long random values. WEBHOOK_SECRET must equal AVENA_REMINDER_WEBHOOK_SECRET on Vercel.
JWT_SECRET=replace_me
WEBHOOK_SECRET=replace_me
PREFERENCES_TOKEN_SECRET=replace_me
PREFERENCES_TOKEN_EXPIRE_DAYS=365

# Optional one-time bootstrap: creates the first owner only if the admin_users table is empty.
# Logins always use the database. Remove these once the first admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEFAULT_TIMEZONE=America/Toronto
SCHEDULER_HORIZON_MONTHS=3
REMINDER_SEND_HOUR_LOCAL=10
REMINDER_MAX_ATTEMPTS=3
REMINDER_PROCESSING_TIMEOUT_MINUTES=30
WORKER_POLL_SECONDS=20
SMS_FEATURE_ENABLED=false

# Email: mock (log only) | ses | mailgun
EMAIL_PROVIDER=ses
EMAIL_FROM=no-reply@example.com
SES_REGION=ca-central-1
SES_FROM_EMAIL=no-reply@example.com
SES_CONFIGURATION_SET=

# SES bounce/complaint events via SNS -> https://<api-domain>/v1/webhooks/ses-events?token=<SES_EVENTS_TOKEN>
SES_EVENTS_TOKEN=replace_me
SES_EVENTS_TOPIC_ARN=

# Vercel hosting only: Vercel Cron calls /v1/cron/run-due with this secret (set it in Vercel env vars).
CRON_SECRET=replace_me
